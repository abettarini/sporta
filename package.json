{
  "name": "sporta",
  "version": "3.9.1",
  "description": "Sporta: PWA lista della spesa condivisa in tempo reale, con ricette",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --no-warnings server.js",
    "icons": "node scripts/make-icons.js",
    "db:init": "node scripts/db-init.js",
    "version": "node scripts/sync-version.js && git add public/version.js",
    "sync-version": "node scripts/sync-version.js",
    "emails:preview": "node scripts/email-templates.js preview",
    "emails:sync": "node scripts/email-templates.js sync",
    "vapid": "node -e \"const k=require('web-push').generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\\nVAPID_PRIVATE_KEY='+k.privateKey)\""
  },
  "dependencies": {
    "altcha-lib": "2.8.0",
    "postgres": "3.4.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "liquidjs": "^10.21.1"
  }
}
