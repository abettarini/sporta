{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/ricetta/:slug",
      "destination": "/api?__path=pages/ricetta/:slug"
    },
    {
      "source": "/ricettario/:slug",
      "destination": "/api?__path=pages/ricettario/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?__path=pages/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api?__path=pages/robots.txt"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__path=:path*"
    },
    {
      "source": "/r/:token",
      "destination": "/index.html"
    },
    {
      "source": "/e/:token",
      "destination": "/index.html"
    },
    {
      "source": "/share",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/version.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/events",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-transform"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/((?!ricetta/|ricettario/|sitemap\\.xml|robots\\.txt|api/photos/).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 6 * * *"
    }
  ]
}
