{
  "name": "sporta",
  "version": "2.4.0",
  "description": "Sporta: PWA lista della spesa condivisa in tempo reale, con ricette",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --no-warnings server.js",
    "icons": "node scripts/make-icons.js",
